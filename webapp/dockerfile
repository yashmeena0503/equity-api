FROM node:24-alpine AS base

WORKDIR /app

COPY package*.json ./
RUN npm ci


FROM base AS dev

COPY . .

CMD ["npm", "run", "dev"]


FROM base AS build

COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build


FROM nginx:alpine AS prod

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
